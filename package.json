{
  "name": "flow-linear",
  "version": "0.1.0",
  "description": "Add Linear tickets to Flow's Focus list and keep them in step with a Linear label.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "tsc -noEmit -skipLibCheck && eslint . --max-warnings=0",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,md}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "verify": "npm run build && npm test",
    "release": "tsx scripts/release.ts",
    "prepare": "husky"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "flow",
    "linear",
    "gtd"
  ],
  "author": "Ben Phillips",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.19",
    "esbuild": "0.25.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "obsidian": "1.13.1",
    "prettier": "3.6.2",
    "ts-jest": "29.4.4",
    "tslib": "2.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
